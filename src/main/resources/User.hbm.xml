<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.example.demo.model.User" table="users">
        <id name="id" type="long">
            <column name="id"/>
            <generator class="identity"/>
        </id>

        <property name="username">
            <column name="username" length="50" not-null="true" unique="true"/>
        </property>

        <property name="password">
            <column name="password" not-null="true"/>
        </property>

        <property name="email">
            <column name="email" not-null="true" unique="true"/>
        </property>

        <property name="role">
            <column name="role" not-null="true"/>
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">com.example.demo.model.UserRole</param>
                <param name="useNamed">true</param>
            </type>
        </property>

        <property name="status">
            <column name="status" not-null="true"/>
        </property>

        <property name="createdAt">
            <column name="created_at"/>
            <type name="org.hibernate.type.LocalDateTimeType"/>
        </property>
    </class>
</hibernate-mapping>