<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.example.demo.model.Submission" table="submissions">
        <id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <many-to-one name="assignment" class="com.example.demo.model.Assignment">
            <column name="assignment_id" not-null="true"/>
        </many-to-one>
        <many-to-one name="student" class="com.example.demo.model.User">
            <column name="student_id" not-null="true"/>
        </many-to-one>
        <property name="fileUrl" type="string">
            <column name="file_url"/>
        </property>
        <property name="submissionDate" type="java.time.LocalDateTime">
            <column name="submission_date"/>
        </property>
        <property name="status" type="string">
            <column name="status"/>
        </property>
        <property name="grade" type="double">
            <column name="grade"/>
        </property>
        <property name="feedback" type="string">
            <column name="feedback"/>
        </property>
    </class>
</hibernate-mapping>