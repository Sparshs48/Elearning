<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.example.demo.model.Enrollment" table="enrollments">
        <id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <many-to-one name="student" class="com.example.demo.model.User">
            <column name="student_id" not-null="true"/>
        </many-to-one>
        <many-to-one name="course" class="com.example.demo.model.Course">
            <column name="course_id" not-null="true"/>
        </many-to-one>
        <property name="enrollmentDate" type="java.time.LocalDateTime">
            <column name="enrollment_date"/>
        </property>
        <property name="status" type="string">
            <column name="status" not-null="true"/>
        </property>
    </class>
</hibernate-mapping>